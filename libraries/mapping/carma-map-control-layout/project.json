{
  "name": "carma-map-controls-layout",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/mapping/carma-map-control-layout/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/libraries/mapping/carma-map-control-layout"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/libraries/mapping/carma-map-control-layout"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "storybook": {
      "options": {
        "port": 4400,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": [
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../../dist/storybook/map-control"
      },
      "configurations": {
        "ci": {
          "storybook": {
            "executor": "@nx/storybook:storybook",
            "options": {
              "port": 4400,
              "configDir": "libraries/mapping/carma-map-control-layout/.storybook"
            },
            "configurations": {
              "ci": {
                "quiet": true
              }
            }
          },
          "build-storybook": {
            "executor": "@nx/storybook:build",
            "outputs": ["{options.outputDir}"],
            "options": {
              "outputDir": "dist/storybook/map-control",
              "configDir": "libraries/mapping/carma-map-control-layout/.storybook"
            },
            "configurations": {
              "ci": {
                "quiet": true
              }
            }
          },
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c libraries/mapping/carma-map-control-layout/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "carma-map-controls-layout:build-storybook",
        "staticFilePath": "dist/storybook/map-control"
      },
      "configurations": {
        "ci": {
          "buildTarget": "carma-map-controls-layout:build-storybook:ci"
        }
      }
    }
  }
}
