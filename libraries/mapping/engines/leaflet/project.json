{
  "name": "carma-map-engines-leaflet",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/mapping/engines/leaflet/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/libraries/mapping/engines/leaflet"
      ],
      "options": {
        "outDir": "../../../../dist/libraries/mapping/engines/leaflet"
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libraries/mapping/engines/leaflet"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../../coverage/libraries/mapping/engines/leaflet"
      }
    }
  }
}
