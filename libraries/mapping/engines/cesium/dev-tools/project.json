{
  "name": "cesium/dev-tools",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/mapping/engines/cesium/dev-tools/src",
  "projectType": "library",
  "tags": [
    "type:library",
    "scope:cesium"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libraries/mapping/engines/cesium/dev-tools"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "../../../../../coverage/libraries/mapping/engines/cesium/dev-tools",
        "environment": "jsdom"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
