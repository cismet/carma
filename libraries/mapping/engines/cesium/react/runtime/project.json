{
  "name": "cesium-react-runtime",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/mapping/engines/cesium/react/runtime/src",
  "projectType": "library",
  "tags": ["type:library", "scope:cesium"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libraries/mapping/engines/cesium/react/runtime"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../../../../coverage/libraries/mapping/engines/cesium/react/runtime"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "lint-quiet": {
      "executor": "@nx/eslint:lint",
      "options": {
        "quiet": true,
        "maxWarnings": -1
      }
    }
  }
}
