{
  "name": "maplibre-gl-utils",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/mapping/engines/maplibre-gl/utils/src",
  "projectType": "library",
  "tags": ["type:library", "scope:maplibre"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libraries/mapping/engines/maplibre-gl/utils"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../../../coverage/libraries/mapping/engines/maplibre-gl/utils"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
