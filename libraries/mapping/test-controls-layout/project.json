{
  "name": "test-controls-layout",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/mapping/test-controls-layout/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libraries/mapping/test-controls-layout"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 4400,
        "configDir": "libraries/mapping/test-controls-layout/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/map-control",
        "configDir": "libraries/mapping/test-controls-layout/.storybook"
      },
      "configurations": {
        "ci": {
          "storybook": {
            "executor": "@nx/storybook:storybook",
            "options": {
              "port": 4400,
              "configDir": "libraries/mapping/test-controls-layout/.storybook"
            },
            "configurations": {
              "ci": {
                "quiet": true
              }
            }
          },
          "build-storybook": {
            "executor": "@nx/storybook:build",
            "outputs": ["{options.outputDir}"],
            "options": {
              "outputDir": "dist/storybook/map-control",
              "configDir": "libraries/mapping/test-controls-layout/.storybook"
            },
            "configurations": {
              "ci": {
                "quiet": true
              }
            }
          },
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c libraries/mapping/test-controls-layout/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "test-controls-layout:build-storybook",
        "staticFilePath": "dist/storybook/map-control"
      },
      "configurations": {
        "ci": {
          "buildTarget": "test-controls-layout:build-storybook:ci"
        }
      }
    }
  }
}
