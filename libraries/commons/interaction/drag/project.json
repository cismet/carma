{
  "name": "interaction-drag",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/commons/interaction/drag/src",
  "projectType": "library",
  "tags": ["type:util", "scope:commons"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libraries/commons/interaction/drag"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/dist/.vite/interaction-drag"],
      "options": {
        "config": "libraries/commons/interaction/drag/vite.config.ts"
      }
    }
  }
}
