{
  "name": "pw-helper",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libraries/e2e/pw-helper/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libraries/e2e/pw-helper",
        "main": "libraries/e2e/pw-helper/src/index.ts",
        "tsConfig": "libraries/e2e/pw-helper/tsconfig.lib.json",
        "assets": ["libraries/e2e/pw-helper/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libraries/e2e/pw-helper/jest.config.ts"
      }
    }
  }
}
