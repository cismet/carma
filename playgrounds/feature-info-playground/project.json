{
  "name": "feature-info-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "playgrounds/feature-info-playground/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/playgrounds/feature-info-playground"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/playgrounds/feature-info-playground"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/playgrounds/feature-info-playground"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/playgrounds/feature-info-playground"
      }
    }
  }
}
