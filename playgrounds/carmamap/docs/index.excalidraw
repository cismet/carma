    {
      "id": "cQeuA3kP3wCsi_7DgRkn7",
      "type": "text",
      "x": 1199.2009782661032,
      "y": -426.4838575561854,
      "width": 1423.4759521484375,
      "height": 198.3118381521687,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 280068138,
      "version": 950,
      "versionNonce": 1442844225,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "rAW3lQTBY-b-9axCEWXdo",
          "type": "arrow"
        }
      ],
      "updated": 1732653806231,
      "link": null,
      "locked": false,
      "text": "For Transition period CarmaMap should still expose TopicMap and  CustomViewer, \nbut interfaces should be start to become more abstracted away.\n\nIf the Unified Map Proxy Component implementation looks like it will become too inconsistent or complex (n:m).\nHaving two targets for Controls, MapMeasurement, Routing is acceptable.\nFuzzySearch needs to be decoupled, and should not have to manage EntitySelections in the map.",
      "fontSize": 26.441578420289158,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For Transition period CarmaMap should still expose TopicMap and  CustomViewer, \nbut interfaces should be start to become more abstracted away.\n\nIf the Unified Map Proxy Component implementation looks like it will become too inconsistent or complex (n:m).\nHaving two targets for Controls, MapMeasurement, Routing is acceptable.\nFuzzySearch needs to be decoupled, and should not have to manage EntitySelections in the map.",
      "autoResize": true,
      "lineHeight": 1.25
    },
