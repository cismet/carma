    {
      "id": "cQeuA3kP3wCsi_7DgRkn7",
      "type": "text",
      "x": -1228.894202050505,
      "y": -1164.7243153472207,
      "width": 1042.7491762507634,
      "height": 145.27081090610864,
      "angle": 0,
      "strokeColor": "#e03131",
