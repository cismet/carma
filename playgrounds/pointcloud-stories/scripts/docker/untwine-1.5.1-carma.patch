-PyramidManager::PyramidManager(const BaseInfo& b) : m_b(b), m_pool(10), m_totalPoints(0),
+namespace
+{
+
+std::size_t pyramidThreadCount()
+{
+    const char *configured = std::getenv("UNTWINE_PYRAMID_THREADS");
+    if (!configured)
+        return 4;
+
+    char *end = nullptr;
+    unsigned long value = std::strtoul(configured, &end, 10);
+    if (end == configured || *end != '\0' || value < 1 || value > 64)
+        return 4;
+    return value;
+}
+
+} // unnamed namespace
+
+PyramidManager::PyramidManager(const BaseInfo& b) : m_b(b), m_pool(pyramidThreadCount()), m_totalPoints(0),
     m_copc(m_b)
 {}
 
