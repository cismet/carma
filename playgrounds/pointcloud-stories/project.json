{
  "name": "pointcloud-stories",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "playgrounds/pointcloud-stories/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 4440,
        "configDir": "playgrounds/pointcloud-stories/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/playgrounds/pointcloud-stories",
        "configDir": "playgrounds/pointcloud-stories/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        },
        "production": {}
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/pointcloud-stories",
        "configDir": "playgrounds/pointcloud-stories/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
