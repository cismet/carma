# Optional. Relative paths resolve from this Storybook project root.
POINTCLOUD_DATA_ROOT=.data
POINTCLOUD_UNTWINE_IMAGE=local/untwine
POINTCLOUD_PDAL_IMAGE=local/pdal-py
# Memory-bounded default; raise only on a host with sufficient free RAM.
POINTCLOUD_UNTWINE_PYRAMID_THREADS=4

# Public browser runtime origins. Keep unpublished source locations out of Git.
VITE_POINTCLOUD_DATA_BASE_URL=https://wupp-3d-data.cismet.de/mesh2024/pointclouds
VITE_PANORAMA_BASE_URL=

# Local source inputs. Configure machine-specific paths only in .env.local.
POINTCLOUD_KWH_SOURCE=
POINTCLOUD_AWG_SOURCE=
POINTCLOUD_OELBERG_MLS_SOURCE=
POINTCLOUD_NORDBAHN_SOURCE=
POINTCLOUD_OELBERG_RAW_ROOT=
POINTCLOUD_NORDBAHN_RAW_ROOT=
GEORADAR_SOURCE_ROOT=
CAPTURE_026_T0_SOURCE=
CAPTURE_026_PLANAR2_REFERENCE=
CAPTURE_026_PLANAR2_ARCHIVE=
CAPTURE_026_PLANAR3_REFERENCE=
CAPTURE_026_PLANAR3_ARCHIVE=

# Mesh-assisted AO settings.
POINTCLOUD_AO_MESH_ERROR_METERS=0.5
POINTCLOUD_AO_VOXEL_METERS=0.5
POINTCLOUD_AO_RAY_LENGTH_METERS=50
POINTCLOUD_AO_RAY_COUNT=256
POINTCLOUD_AO_SELF_BIAS_METERS=1
POINTCLOUD_AO_FOOTPRINT_CELL_METERS=25
POINTCLOUD_AO_KEEP_CACHE=false
