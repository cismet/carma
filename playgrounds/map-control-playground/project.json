{
  "name": "map-control-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "playgrounds/map-control-playground/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/playgrounds/generic-topicmaps"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/playgrounds/map-control-playground"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "storybook": {
      "options": {
        "port": 4400,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": [
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/map-control-playground"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c playgrounds/map-control-playground/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "map-control-playground:build-storybook",
        "staticFilePath": "dist/storybook/map-control-playground"
      },
      "configurations": {
        "ci": {
          "buildTarget": "map-control-playground:build-storybook:ci"
        }
      }
    }
  }
}
