{
  "compileOnSave": false,
  "include": [
    "${configDir}/src/**/*.js",
    "${configDir}/src/**/*.ts",
    "${configDir}/src/**/*.jsx",
    "${configDir}/src/**/*.tsx",
    "${configDir}/*.config.js",
    "${configDir}/*.config.ts",
    "${configDir}/*.config.cjs",
    "${configDir}/*.config.mjs",
    "${configDir}/*.config.mts"
  ],
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "preserve",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "sourceMap": true,
    "moduleDetection": "force",
    "rootDir": ".",
    "baseUrl": ".",
    "types": [
      "vite/client",
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "@nx/react/typings/styled-jsx.d.ts"
    ],
    "paths": {
      "@carma-appframeworks/*": ["libraries/appframeworks/*/src/index.ts"],
      "@carma-commons/*": ["libraries/commons/*/src/index.ts"],
      "@carma-commons/ui/shadcn": ["libraries/commons/ui/shadcn/src/index.ts"],
      "@carma-units": ["libraries/units/src/index.ts"],
      "@carma-geo/*": ["libraries/geo/*/src/index.ts"],
      "@carma-mapping/annotations/builtin-tools/annotation-mode-text": [
        "libraries/mapping/annotations/builtin-tools/src/lib/annotation-mode-text.ts"
      ],
      "@carma-mapping/*": ["libraries/mapping/*/src/index.ts"],
      "@carma-providers/*": ["libraries/providers/*/src/index.ts"],
      "@carma-collab/pecher/*": ["libraries/collaboration/carma-pecher-collab/src/*/index.jsx"],
      "@carma-collab/wuppertal/*": ["libraries/collaboration/carma-wuppertal-collab/src/*/index.ts"],
      // legacy aliases to carma-commons/math, to be removed after collaboration code is migrated to use carma-commons/math instead of carma/math
      "@carma-cesium": ["libraries/mapping/engines/cesium/api/src/index.ts"], // curated low level API for Cesium replacing direct imports from cesium
     }
  }
}
