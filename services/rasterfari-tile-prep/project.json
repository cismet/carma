{
  "name": "rasterfari-tile-prep",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/rasterfari-tile-prep/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/services/rasterfari-tile-prep"],
      "options": {
        "command": "bash -c 'mkdir -p ../../dist/services/rasterfari-tile-prep && cp src/version.json ../../dist/services/rasterfari-tile-prep/version.json'",
        "cwd": "services/rasterfari-tile-prep",
        "forwardAllArgs": false
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64"],
        "push": true,
        "tags": ["cismet/carma-rasterfari-tile-prep:latest"]
      }
    }
  }
}
