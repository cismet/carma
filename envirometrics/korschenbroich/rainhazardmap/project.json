{
  "name": "rainhazardmap-korschenbroich",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "envirometrics/korschenbroich/rainhazardmap/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/envirometrics/korschenbroich/rainhazardmap"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/envirometrics/korschenbroich/rainhazardmap"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/envirometrics/korschenbroich/rainhazardmap"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/envirometrics/korschenbroich/rainhazardmap"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64", "linux/arm64"],
        "push": true,
        "tags": ["cismet/carma-ais-korschenbroich:latest"]
      }
    }
  }
}
