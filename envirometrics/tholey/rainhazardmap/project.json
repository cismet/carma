{
  "name": "rainhazardmap-tholey",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "envirometrics/tholey/rainhazardmap/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/envirometrics/tholey/rainhazardmap"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/envirometrics/tholey/rainhazardmap"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/envirometrics/tholey/rainhazardmap"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/envirometrics/tholey/rainhazardmap"
      }
    }
  }
}
