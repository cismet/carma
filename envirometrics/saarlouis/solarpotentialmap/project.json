{
  "name": "solarpotentialmap-saarlouis",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "envirometrics/saarlouis/solarpotentialmap/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/envirometrics/saarlouis/solarpotentialmap"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/envirometrics/saarlouis/solarpotentialmap"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "buildTarget": "solarpotentialmap-saarlouis:build:development"
        },
        "production": {
          "buildTarget": "solarpotentialmap-saarlouis:build:production"
        }
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64", "linux/arm64"],
        "push": true
      },
    }
  }
}
