{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "nx-geoportal:serve:development",
      "command": "npx nx serve geoportal --configuration=development --output-style=stream-without-prefixes",
      "problemMatcher": {
        "fileLocation": ["relative", "${workspaceFolder:carma}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "nx serve geoportal --configuration=development",
          "endsPattern": "Local:   http://localhost:"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "kill-geoportal-server",
      "type": "shell",
      "command": "pkill -f 'nx serve geoportal'",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true
      }
    }
  ]
}
