{
  "name": "verdis-online",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/verdis/online/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "inputs": [
        "default",
        {
          "env": "VITE_CIDS_SERVICE"
        }
      ],
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/apps/verdis/online"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/apps/verdis/online"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/verdis/online"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/apps/verdis/online"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64", "linux/arm64"],
        "push": true
      },
      "inputs": [
        "default",
        {
          "env": "VITE_CIDS_SERVICE"
        }
      ]
    }
  }
}
