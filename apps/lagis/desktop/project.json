{
  "name": "lagis-desktop",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/lagis/desktop/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/apps/lagis/desktop"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../dist/apps/lagis/desktop"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/lagis/desktop"
      ],
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/apps/lagis/desktop"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "lagis-desktop:build"
      }
    },
    "getVersion_": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo PCKG_VERSION=$(cat $(pwd)/package.json | jq -r '.version') > {projectRoot}/.env"
      }
    },
    "getVersion": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo PCKG_VERSION=$(node -p \"require('./package.json').version\") > {projectRoot}/.env"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build", "getVersion"],
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64", "linux/arm64"],
        "push": true,
        "metadata": {
          "images": ["cismet/carma-{projectName}"],
          "load": true,
          "tags": [
            "type=schedule",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=sha,prefix=sha-",
            "type=raw,$PCKG_VERSION",
            "type=raw,latest"
          ]
        }
      }
    },
    "envtest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "X=1; echo TESTING: $X . {projectName} {projectRoot}"
      }
    }
  }
}
